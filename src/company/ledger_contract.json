    "complaint": {"group": "Honesty", "writers": ["board"], "required": ["source", "summary"], "optional": ["bet", "contact"]},
    "spam-flag": {"group": "Honesty", "writers": ["board"], "required": ["source"], "optional": ["bet", "contact"]},
