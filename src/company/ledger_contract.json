{
  "about": [
    "The ledger contract: every event kind, the writers allowed to append it, and its required and optional fields.",
    "It mirrors the table under \"Event kinds\" in docs/design.md, and a test holds the two equal.",
    "Every line also holds seq, ts, kind, writer and prev, which the ledger sets itself.",
    "writers lists each writer by the group the design names; cell:<bet> stands for cell: and any bet id.",
    "field_types carries the design's field conventions: a field takes the type of its exact name, or else of its suffix; a field with neither may hold any JSON value."
  ],
  "writers": {
    "board": ["board"],
    "code": ["treasurer", "governor", "launcher", "scheduler", "killswitch", "runner"],
    "agents": ["cell:<bet>", "strategy", "auditor", "retro", "probe"]
  },
  "field_types": {
    "names": {"session": "uuid", "bet": "bet", "message": "discord-id", "amount": "decimal", "cost": "decimal", "equity": "signed-decimal", "pnl": "signed-decimal", "weight": "number", "minutes": "minutes", "week_start": "timestamp", "charge_id": "uuid", "charge_lines": "count", "sessions": "count"},
    "suffixes": {"_seq": "seq", "_seqs": "seqs", "_at": "timestamp", "_date": "date"}
  },
  "kinds": {
    "settings-changed": {"group": "Governance", "writers": ["board"], "required": ["digest", "keys"], "optional": ["message"]},
