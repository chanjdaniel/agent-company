    "bet-closed": {"group": "Opportunity", "writers": ["treasurer"], "required": ["bet", "reason"], "optional": []},
    "approval-asked": {"group": "Batch", "writers": ["scheduler"], "required": ["subject_seq", "action", "minutes", "expected_margin"], "optional": ["bet"]},
    "approval-decided": {"group": "Batch", "writers": ["board"], "required": ["ask_seq", "decision"], "optional": ["note", "message"]},
    "target-proposed": {"group": "Outreach", "writers": ["cell:<bet>"], "required": ["contact", "organization", "reason", "source"], "optional": []},
    "draft-proposed": {"group": "Outreach", "writers": ["cell:<bet>"], "required": ["target_seq", "body", "claims", "disclosure", "unsubscribe"], "optional": []},
    "target-refused": {"group": "Outreach", "writers": ["treasurer"], "required": ["reason"], "optional": ["session"]},
    "draft-refused": {"group": "Outreach", "writers": ["treasurer"], "required": ["reason", "target_seq"], "optional": ["uncited_claims", "session"]},
    "send-confirmed": {"group": "Outreach", "writers": ["board"], "required": ["draft_seq", "sent_at"], "optional": []},
    "reply": {"group": "Outreach", "writers": ["board"], "required": ["draft_seq", "summary"], "optional": []},
    "opt-out": {"group": "Outreach", "writers": ["board"], "required": ["contact"], "optional": ["draft_seq"]},
    "split-proposed": {"group": "Portfolio", "writers": ["cell:<bet>"], "required": ["week_start", "split", "reason"], "optional": []},
    "split-set": {"group": "Portfolio", "writers": ["treasurer"], "required": ["week_start", "split", "inputs"], "optional": ["holdout_bet"]},
    "split-override": {"group": "Portfolio", "writers": ["board"], "required": ["week_start", "split", "message"], "optional": ["reason"]},
    "incident": {"group": "Operating", "writers": ["treasurer"], "required": ["cause_seq", "class"], "optional": ["bet"]},
    "postmortem": {"group": "Operating", "writers": ["retro"], "required": ["incident_seq", "what_happened", "cue", "lesson", "evidence"], "optional": []},
    "retro-proposal": {"group": "Operating", "writers": ["retro"], "required": ["rank", "summary", "changes", "evidence", "daniel_only"], "optional": ["cue", "lesson", "keep_current", "past_change_verdicts"]},
    "proposal-decided": {"group": "Operating", "writers": ["board"], "required": ["proposal_seq", "decision"], "optional": ["reason", "message"]},
    "procedure-version": {"group": "Operating", "writers": ["board"], "required": ["procedure", "version", "path", "hash", "reason", "proposal_seq"], "optional": ["restored_from"]},
    "replay-verdict": {"group": "Operating", "writers": ["treasurer"], "required": ["procedure", "version", "passed", "cases", "regressions"], "optional": []}
