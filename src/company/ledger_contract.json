    "go-given": {"group": "Governance", "writers": ["board"], "required": ["scope", "message", "sessions"], "optional": []},
    "schedule-enabled": {"group": "Governance", "writers": ["board"], "required": ["message", "jobs"], "optional": []},
    "schedule-disabled": {"group": "Governance", "writers": ["board", "killswitch"], "required": ["reason"], "optional": []},
    "append-refused": {"group": "Governance", "writers": ["treasurer", "governor", "launcher", "scheduler", "killswitch", "runner"], "required": ["attempted_kind", "attempted_writer", "reason"], "optional": ["session", "tool"]},
    "usage-reading": {"group": "Resources", "writers": ["board", "governor"], "required": ["window", "used_percent", "resets_at", "taken_at", "source"], "optional": []},
    "resource-charged": {"group": "Resources", "writers": ["treasurer"], "required": ["week_start", "line", "weight", "fraction", "company_used", "cost", "reading_seq", "charge_id", "charge_lines"], "optional": []},
    "minutes-charged": {"group": "Resources", "writers": ["treasurer"], "required": ["action", "minutes", "subject_seq"], "optional": ["bet"]},
    "minutes-corrected": {"group": "Resources", "writers": ["board"], "required": ["charge_seq", "minutes"], "optional": ["reason"]},
    "revenue": {"group": "Money", "writers": ["treasurer"], "required": ["amount", "currency", "source", "record"], "optional": ["bet"]},
    "refund": {"group": "Money", "writers": ["treasurer"], "required": ["amount", "currency", "source", "record"], "optional": ["bet"]},
    "fee": {"group": "Money", "writers": ["treasurer"], "required": ["amount", "currency", "source", "record"], "optional": ["bet"]},
    "spend": {"group": "Money", "writers": ["treasurer"], "required": ["amount", "currency", "source", "record"], "optional": ["bet"]},
