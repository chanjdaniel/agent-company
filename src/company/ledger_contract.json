    "experiment-verdict": {"group": "Venture", "writers": ["treasurer"], "required": ["experiment_seq", "outcome", "metric_value", "positive_signal"], "optional": ["veto_seq"]},
    "promise-recorded": {"group": "Honesty", "writers": ["cell:<bet>", "runner"], "required": ["promise", "due_date"], "optional": ["bet", "counterparty"]},
    "promise-checked": {"group": "Honesty", "writers": ["treasurer"], "required": ["promise_seq", "result"], "optional": ["evidence_seqs"]},
    "finding": {"group": "Honesty", "writers": ["auditor", "treasurer", "board"], "required": ["rubric", "summary", "evidence"], "optional": ["bet", "session"]},
